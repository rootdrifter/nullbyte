# nullbyte — exclude credentials, key material, and device-specific data
# Only documentation (Markdown) is tracked in this repository.

# Key material and credentials
*.key
*.pem
*.crt
*.gpg
*.asc
id_*
*_rsa
*_ed25519
*_ed25519.pub
authorized_keys
known_hosts
.env
secrets*

# WireGuard / Tailscale configs (contain keys)
wg*.conf
*.wg
tailscale*.json

# Backups, exports, and per-profile package dumps
*.zip
*.tar
*.tar.gz
*.ab
backup*
package-list*.txt

# Screenshots and captures
*.png
*.jpg
*.jpeg
*.pdf

# OS / editor cruft
.DS_Store
*.swp
*~

# Build-instruction file — keep local, never publish
CLAUDE.md
